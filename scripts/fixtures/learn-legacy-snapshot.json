  "legacy-14": "<div class=\"grid gap-3 sm:grid-cols-2\"><div class=\"rounded-md border border-[#a78bfa]/30 bg-[#a78bfa]/8 p-4\"><p class=\"font-semibold text-[var(--color-ink)]\"><span class=\"\">A</span></p><p class=\"mt-1.5 text-sm text-[var(--color-ink-soft)]\"><span class=\"\">a</span></p></div><div class=\"rounded-md border border-[#a78bfa]/30 bg-[#a78bfa]/8 p-4\"><p class=\"font-semibold text-[var(--color-ink)]\"><span class=\"\">B</span></p><p class=\"mt-1.5 text-sm text-[var(--color-ink-soft)]\"><span class=\"\">b</span></p></div></div>",
  "legacy-15": "<div class=\"rounded-md border border-[#c084fc]/35 bg-[#c084fc]/10 p-4\"><p class=\"text-xs font-semibold uppercase tracking-wide text-[#d29aff]\">Think</p><p class=\"mt-1.5 text-sm text-[var(--color-ink)]\"><span class=\"\">Why?</span></p><button type=\"button\" class=\"mt-3 rounded-md border border-[var(--color-violet)] px-3 py-1.5 text-xs font-medium text-[var(--color-violet)]\">Reveal</button></div>",
