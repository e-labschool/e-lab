# Copy this file to .env and fill in your own Supabase project's values.
# Never commit the real .env file or real credentials.
#
# Both values below are PUBLIC, client-safe credentials (the "anon" key is
# designed to be exposed in frontend code and is meaningless without Row
# Level Security policies enforcing access — see supabase/schema.sql).
# Never put a Supabase service-role key in this file or in any frontend code.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
