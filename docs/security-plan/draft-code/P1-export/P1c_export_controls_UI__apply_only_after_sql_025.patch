diff --git a/src/lib/exportPolicy.js b/src/lib/exportPolicy.js
new file mode 100644
index 0000000..c1ebd76
--- /dev/null
+++ b/src/lib/exportPolicy.js
@@ -0,0 +1,37 @@
+import { useEffect, useState } from "react";
+import { supabase, isSupabaseConfigured } from "./supabaseClient.js";
+
+import { DEFAULT_EXPORT_POLICY, resolveExportPolicy } from "./exportPolicyCore.js";
+export { DEFAULT_EXPORT_POLICY, resolveExportPolicy };
+
+let cached = null;
+let inflight = null;
+export function __resetExportPolicyCacheForTests() { cached = null; inflight = null; }
+
+async function loadExportPolicy(client = supabase) {
+  if (cached) return cached;
+  if (!inflight) {
+    inflight = (async () => {
+      try {
+        const { data, error } = await client.from("platform_export_policy").select("*").maybeSingle();
+        cached = error || !data ? DEFAULT_EXPORT_POLICY : resolveExportPolicy(data);
+      } catch {
+        cached = DEFAULT_EXPORT_POLICY;
+      }
+      return cached;
+    })();
+  }
+  return inflight;
+}
+export { loadExportPolicy };
+
+export function useExportPolicy() {
+  const [policy, setPolicy] = useState(cached ?? DEFAULT_EXPORT_POLICY);
+  useEffect(() => {
+    if (!isSupabaseConfigured || cached) return undefined;
+    let alive = true;
+    loadExportPolicy().then((p) => { if (alive) setPolicy(p); });
+    return () => { alive = false; };
+  }, []);
+  return policy;
+}
diff --git a/src/lib/exportPolicyCore.js b/src/lib/exportPolicyCore.js
new file mode 100644
index 0000000..846afd4
--- /dev/null
+++ b/src/lib/exportPolicyCore.js
@@ -0,0 +1,15 @@
+// PURE half of exportPolicy.js (no Supabase import) so it is unit-testable without a browser environment.
+// What application-provided download / export controls may be SHOWN right now.
+//   allowResourceDownloads  mirrors platform_settings.allow_resource_downloads. For resource FILES the database enforces it too
+//                           (storage policy, sql/032) -- this only keeps the UI honest.
+//   allowTeacherExports     Q Builder Export PDF / Export Word / Print buttons. UI control only (files are generated in the browser).
+// A missing view/column (migration 025 not applied yet) or a failed read means "current behaviour": allowed.
+export const DEFAULT_EXPORT_POLICY = Object.freeze({ allowResourceDownloads: true, allowTeacherExports: true });
+
+export function resolveExportPolicy(row) {
+  return {
+    allowResourceDownloads: row?.allow_resource_downloads !== false,
+    allowTeacherExports: row?.allow_teacher_exports !== false,
+  };
+}
+
