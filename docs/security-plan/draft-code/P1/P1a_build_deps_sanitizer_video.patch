-  return DOMPurify.sanitize(html || "", { ADD_ATTR: ["style", "color"] });
+// The one sanitiser for Learn rich-text HTML (editor paste, student render, admin preview). DOMPurify's default allowlist
+// already keeps everything the Rich Text editor emits: h1-h4, p, span[style] (font-size/-family, color, background-color),
+// b/i/u/s/sub/sup, ul/ol/li, a[href], img, table, and style="text-align" / "margin-left" on blocks. `style` and `color` are added
+// explicitly so this stays true if DOMPurify's defaults ever change; scripts/test-rich-text-selection.mjs locks the round trip in.
+//
+// HARDENING over the previous one-liner (audit C-APP-03). Content is admin-authored, so these are defence in depth against a
+// compromised admin session or a crafted backup restore planting a phishing panel inside a trusted lesson:
+//   * no form controls / style blocks / svg / math / media / frames  (credential-phishing forms, CSS exfiltration, mXSS vectors)
+//   * inline style declarations that can build a full-page overlay (position, inset, top/left/right/bottom, z-index,
+//     pointer-events) or fetch/execute things (url(), expression(), @import, behavior, -moz-binding, CSS escapes) are removed;
+//     all other declarations are untouched, so existing lesson formatting is preserved
+//   * OPTIONAL: restrict <img> to given hosts (allowedImageHosts). OFF by default -- turn on only after scanning the lesson corpus
+//     for external images (sql/00_preflight_readonly.sql Q33).
+// NOT a copy-protection mechanism and NOT a substitute for a CSP.
+
+const FORBID_TAGS = ["form", "input", "button", "textarea", "select", "option", "label", "fieldset", "style", "link", "meta", "base",
+  "svg", "math", "video", "audio", "source", "track", "iframe", "frame", "frameset", "object", "embed", "applet", "template", "noscript"];
+const FORBID_ATTR = ["srcset", "formaction", "action", "ping", "poster", "background"];
+const BLOCKED_STYLE_PROPS = /^(position|inset(-[a-z]+)*|top|left|right|bottom|z-index|behavior|-moz-binding|pointer-events)$/i;
+const BLOCKED_STYLE_VALUES = /url\s*\(|expression\s*\(|javascript\s*:|vbscript\s*:|@import|\\|<|>/i;
+
+export function filterStyleAttribute(value) {
+  return String(value || "")
+    .split(";")
+    .map((d) => d.trim())
+    .filter((d) => {
+      if (!d) return false;
+      const i = d.indexOf(":");
+      if (i < 1) return false;
+      const prop = d.slice(0, i).trim();
+      const val = d.slice(i + 1).trim();
+      return !BLOCKED_STYLE_PROPS.test(prop) && !BLOCKED_STYLE_VALUES.test(val) && !BLOCKED_STYLE_VALUES.test(prop);
+    })
+    .join("; ");
+}
+
+let purify = null;
+let activeImageHosts = null;
+function getPurify() {
+  if (purify) return purify;
+  purify = DOMPurify(typeof window !== "undefined" ? window : undefined); // own instance: hooks must not leak into other DOMPurify users (jsPDF)
+  purify.addHook("uponSanitizeAttribute", (_node, data) => {
+    if (data.attrName === "style") {
+      const cleaned = filterStyleAttribute(data.attrValue);
+      if (cleaned) data.attrValue = cleaned; else data.keepAttr = false;
+    }
+  });
+  purify.addHook("afterSanitizeAttributes", (node) => {
+    if (node.tagName === "IMG" && activeImageHosts) {
+      const src = node.getAttribute("src") || "";
+      if (/^(https?:)?\/\//i.test(src)) {
+        let host = "";
+        try { host = new URL(src, "https://x.invalid").hostname.toLowerCase(); } catch { /* drop below */ }
+        if (!activeImageHosts.has(host)) node.removeAttribute("src");
+      }
+    }
+    if (node.tagName === "A" && node.hasAttribute("target")) node.setAttribute("rel", "noopener noreferrer");
+  });
+  return purify;
+}
+
+export function sanitizeHtml(html, { allowedImageHosts = null } = {}) {
+  const p = getPurify();
+  activeImageHosts = allowedImageHosts ? new Set(allowedImageHosts.map((h) => String(h).toLowerCase())) : null;
+  try {
+    return p.sanitize(html || "", { ADD_ATTR: ["style", "color"], FORBID_TAGS, FORBID_ATTR });
+  } finally {
+    activeImageHosts = null;
+  }
 }
