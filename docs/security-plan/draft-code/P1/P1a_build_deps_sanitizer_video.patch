diff --git a/src/lib/embedUrl.js b/src/lib/embedUrl.js
new file mode 100644
index 0000000..4bcb427
--- /dev/null
+++ b/src/lib/embedUrl.js
@@ -0,0 +1,34 @@
+// Decides how a Learn "video" block URL may be shown. PURE (no DOM, no React) so it is unit-testable.
+//   kind "embed"  -> https iframe from an explicit allow-list (YouTube, Vimeo player)
+//   kind "direct" -> a media file we host (Supabase storage host, or a plain .mp4/.webm/.mov https URL)
+//   kind "link"   -> any other https URL: shown as a link, NEVER framed
+//   kind "none"   -> empty / non-https / unparseable: nothing is rendered from it
+// Replaces substring host tests (`hostname.includes("youtube.com")` would accept "evilyoutube.com").
+const YOUTUBE_HOSTS = new Set(["www.youtube.com", "youtube.com", "m.youtube.com", "www.youtube-nocookie.com"]);
+const VIMEO_HOSTS = new Set(["vimeo.com", "www.vimeo.com", "player.vimeo.com"]);
+const DIRECT_FILE = /\.(mp4|webm|mov)$/i;
+
+export function classifyVideoUrl(raw, { storageHost = "" } = {}) {
+  if (!raw || typeof raw !== "string") return { kind: "none", url: "" };
+  let u;
+  try { u = new URL(raw.trim()); } catch { return { kind: "none", url: "" }; }
+  if (u.protocol !== "https:") return { kind: "none", url: "" };
+  const host = u.hostname.toLowerCase();
+
+  if (YOUTUBE_HOSTS.has(host)) {
+    if (u.pathname.startsWith("/embed/")) return { kind: "embed", url: `https://www.youtube.com${u.pathname}${u.search}` };
+    const id = u.searchParams.get("v");
+    if (id && /^[\w-]{6,20}$/.test(id)) return { kind: "embed", url: `https://www.youtube.com/embed/${id}` };
+    return { kind: "link", url: u.href };
+  }
+  if (host === "youtu.be") {
+    const id = u.pathname.slice(1);
+    return /^[\w-]{6,20}$/.test(id) ? { kind: "embed", url: `https://www.youtube.com/embed/${id}` } : { kind: "link", url: u.href };
+  }
+  if (VIMEO_HOSTS.has(host)) {
+    const id = u.pathname.split("/").filter(Boolean).pop();
+    return id && /^\d+$/.test(id) ? { kind: "embed", url: `https://player.vimeo.com/video/${id}` } : { kind: "link", url: u.href };
+  }
+  if ((storageHost && host === storageHost.toLowerCase()) || DIRECT_FILE.test(u.pathname)) return { kind: "direct", url: u.href };
+  return { kind: "link", url: u.href };
+}
diff --git a/src/lib/sanitizeHtml.js b/src/lib/sanitizeHtml.js
index adf2f6a..799e679 100644
--- a/src/lib/sanitizeHtml.js
+++ b/src/lib/sanitizeHtml.js
@@ -1,12 +1,72 @@
 import DOMPurify from "dompurify";
 
-// The one sanitiser for Learn rich-text HTML (editor paste, student render,
-// admin preview). DOMPurify's default allowlist already keeps everything the
-// Rich Text editor emits: h1-h4, p, span[style] (font-size/-family, color,
-// background-color), b/i/u/s/sub/sup, ul/ol/li, a[href], and style="text-align"
-// / "margin-left" on blocks. `style` and `color` are added explicitly so this
-// stays true if DOMPurify's defaults ever change; tests in
