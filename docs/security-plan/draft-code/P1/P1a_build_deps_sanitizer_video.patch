new file mode 100644
index 0000000..b2dca5d
--- /dev/null
+++ b/scripts/check-build-security.mjs
@@ -0,0 +1,28 @@
+#!/usr/bin/env node
+// DRAFT (docs/security-plan P1/P9). Inspects a built dist/ directory. Never prints secret values (only file name + rule).
+// Usage: node scripts/check-build-security.mjs [dist]
+import fs from "node:fs"; import path from "node:path";
+const dist = process.argv[2] || "dist"; const fail = []; const note = [];
+const walk = (d) => fs.readdirSync(d, { withFileTypes: true }).flatMap((e) => e.isDirectory() ? walk(path.join(d, e.name)) : [path.join(d, e.name)]);
+const files = walk(dist);
+for (const f of files) {
+  const rel = path.relative(dist, f);
+  if (/\.map$/.test(f)) fail.push(`source map shipped: ${rel}`);
+  if (/\.(sql|env|bak|backup|log|zip|tar|gz|pem|key)$/i.test(f) || /(^|\/)\.(env|git(?!keep))/.test(rel)) fail.push(`non-frontend file shipped: ${rel}`);
+  if (/^(supabase|migrations|docs|scripts|node_modules|src)\//.test(rel)) fail.push(`source/dev directory shipped: ${rel}`);
+  if (/\.(js|css|html)$/.test(f)) {
+    const t = fs.readFileSync(f, "utf8");
+    if (/sourceMappingURL=/.test(t)) fail.push(`sourceMappingURL comment: ${rel}`);
+    if (/service_role/i.test(t) && /eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}\./.test(t)) {
+      for (const m of t.matchAll(/eyJ[A-Za-z0-9_-]{20,}\.([A-Za-z0-9_-]{20,})\./g)) { try { if (JSON.parse(Buffer.from(m[1], "base64url").toString()).role === "service_role") fail.push(`service_role JWT in ${rel}`); } catch { /* not JSON */ } }
+    }
+    if (/sb_secret_[A-Za-z0-9_-]{10,}/.test(t)) fail.push(`sb_secret_ key pattern in ${rel}`);
+    if (/postgres(ql)?:\/\/[^\s"']+:[^\s"']+@/.test(t)) fail.push(`database connection string pattern in ${rel}`);
+    if (/-----BEGIN [A-Z ]*PRIVATE KEY-----/.test(t)) fail.push(`private key block in ${rel}`);
+  }
+}
+const pub = files.map((f) => path.relative(dist, f)).filter((r) => !r.startsWith("assets/") && r !== "index.html");
+note.push(`non-asset files in dist (review: only things the frontend needs): ${pub.join(", ") || "(none)"}`);
+note.push(`${files.length} files, ${files.filter((f) => f.endsWith(".js")).length} js chunks (static JS is retrievable by anyone who can load the site)`);
+note.forEach((n) => console.log("INFO", n)); fail.forEach((x) => console.log("FAIL", x));
+console.log(fail.length ? `${fail.length} problem(s)` : "OK"); process.exit(fail.length ? 1 : 0);
