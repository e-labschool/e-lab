diff --git a/src/lib/asyncCache.js b/src/lib/asyncCache.js
new file mode 100644
index 0000000..6fda4c2
--- /dev/null
+++ b/src/lib/asyncCache.js
@@ -0,0 +1,20 @@
+// Tiny TTL cache with in-flight de-duplication. Used to stop the Learn sidebar, lesson page, search box and welcome page each
+// re-requesting the same lesson catalogue on every navigation (fewer requests = more headroom under server-side rate limits).
+// Failed promises are NOT cached. PURE apart from Date.now().
+export function createAsyncCache({ ttlMs = 60_000, now = () => Date.now() } = {}) {
+  const store = new Map();
+  return {
+    async get(key, loader) {
+      const hit = store.get(key);
+      if (hit && (hit.promise || hit.expires > now())) return hit.promise ?? hit.value;
+      const promise = Promise.resolve().then(loader).then(
+        (value) => { store.set(key, { value, expires: now() + ttlMs }); return value; },
+        (error) => { store.delete(key); throw error; },
+      );
+      store.set(key, { promise });
+      return promise;
+    },
+    clear() { store.clear(); },
+    size() { return store.size; },
+  };
+}
