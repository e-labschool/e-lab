@@ -0,0 +1,15 @@
+#!/usr/bin/env node
+// DRAFT (docs/security-plan P1). Static guard: student-facing Learn code must not gain application-provided print/PDF/Word/download controls.
+// Allow-list = known, reviewed uses. Run: node scripts/check-learn-export-controls.mjs   (exit 1 on a new hit).
+import fs from "node:fs"; import path from "node:path";
+const ROOTS = ["src/components/learn", "src/components/image-viewer", "src/pages/student/learn", "src/pages/learn"].filter((d) => fs.existsSync(d));
+const PATTERN = /window\.print\s*\(|from\s+["']jspdf["']|from\s+["']docx["']|\bsaveAs\s*\(|createObjectURL|\bdownload\s*=|\.download\b|<a[^>]*\bdownload\b|toBlob\s*\(|toDataURL\s*\(/;
+const ALLOW = [{ file: "src/components/image-viewer/EnlargeGraphicButton.jsx", why: "toDataURL draws a canvas into the in-page enlarge dialog; no file is produced" }];
+const walk = (d) => fs.readdirSync(d, { withFileTypes: true }).flatMap((e) => e.isDirectory() ? walk(path.join(d, e.name)) : [path.join(d, e.name)]);
+let bad = 0;
+for (const f of ROOTS.flatMap(walk).filter((f) => /\.(jsx?|tsx?)$/.test(f))) {
+  fs.readFileSync(f, "utf8").split("\n").forEach((line, i) => {
+    if (PATTERN.test(line) && !ALLOW.some((a) => a.file === f)) { console.log(`HIT ${f}:${i + 1}: ${line.trim().slice(0, 120)}`); bad++; }
+  });
+}
+console.log(bad ? `${bad} unreviewed export-like call(s)` : `OK: no export controls in ${ROOTS.join(", ")}`); process.exit(bad ? 1 : 0);
